# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#
#   cp .env.example .env
#
# The app starts without any of these set; individual features fail at request
# time when the key they need is missing.

# Server-side Google key. Used for the Geocoding API and the Places API (New).
# Required by: POST /api/discover
GOOGLE_MAPS_API_KEY=

# Google Gemini key, used to generate product ideas and the pitch script.
# Required by: POST /api/process/:id
GEMINI_API_KEY=

# Browser-side Google Maps JavaScript API key. This one is exposed to the
# client by design, so restrict it by HTTP referrer in the Google Cloud
# console. Required by: the map view and the discovery location picker.
NUXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Optional. Path to the local SQLite file.
# Defaults to `data/prospectforge.db` relative to the working directory.
# PROSPECTFORGE_DB_PATH=data/prospectforge.db
